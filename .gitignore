# Node.js dependencies
node_modules/

# Production build output
dist/
build/

# Local environment files and secrets (never commit)
.env
.env.*
!.env.example

# Local database and runtime data (the SQLite file contains password hashes; never commit or share)
backend/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Vite cache
.vite/

# Generated output and user data
mnt/user-data/outputs/

# Optional npm cache
.npm/

# Yarn v2 cache
.yarn/cache/

# editor directories
.vscode/
.idea/

# generated by frontend/tests/browser
frontend/tests/browser/app.js
frontend/tests/browser/shots/
__pycache__/
