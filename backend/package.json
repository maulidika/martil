{
  "name": "martil-backend",
  "version": "1.0.0",
  "description": "Martil multiplayer card game server",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node ../scripts/run-tests.mjs --only backend",
    "test:jest": "jest",
    "test:sim": "node tests/reconnect.sim.js",
    "test:combo": "node tests/combo.consistency.js",
    "test:nav": "node tests/room-navigation.sim.js",
    "test:kick": "node tests/kick.sim.js",
    "test:cardids": "node tests/card-ids.sim.js",
    "test:payload": "node tests/payload-guards.sim.js",
    "test:timer": "node tests/turn-timer.sim.js",
    "test:intermission": "node tests/intermission.sim.js",
    "test:maxgames": "node tests/max-games.sim.js",
    "test:singleroom": "node tests/single-room.sim.js",
    "test:profiles": "node tests/profiles.sim.js",
    "test:hostkeep": "node tests/host-retention.sim.js",
    "test:config": "node tests/config-jwt.sim.js",
    "test:debuglog": "node tests/debug-log.sim.js",
    "test:db": "node tests/db-schema.sim.js",
    "test:persistence": "node tests/db-persistence.sim.js",
    "test:codecase": "node tests/room-code-case.sim.js",
    "test:constants": "node tests/constants.sim.js",
    "test:roomstore": "node tests/room-store.sim.js",
    "test:gameflow": "node tests/game-flow.sim.js",
    "test:outgoing": "node tests/outgoing.sim.js",
    "test:authroutes": "node tests/auth-routes.sim.js",
    "test:joinevents": "node tests/join-events.sim.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
