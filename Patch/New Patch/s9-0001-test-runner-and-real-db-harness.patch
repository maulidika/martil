+    failed += 1;
+    console.log(`  FAIL  ${t.name}\n        ${String(e.stack || e.message).split('\n').slice(0, 8).join('\n        ')}`);
+  }
+}
+fs.rmSync(tmp, { recursive: true, force: true });
+console.log(`\n${tests.length - failed}/${tests.length} lulus`);
