+# Copy this file to backend/.env and fill it in. backend/.env is git-ignored: never commit it.
+# This example contains placeholders only; never paste real secrets here.
+
+# Set to "production" on a deployed server. Leave unset for local development.
+# In production the server refuses to start without JWT_SECRET.
+# NODE_ENV=production
+
+PORT=3001
+
+# The single origin allowed by CORS (REST and Socket.IO). Must match the frontend URL exactly.
+CLIENT_URL=http://localhost:5173
+
+# Secret used to sign login tokens. Leave empty for local development (a built-in development
+# secret is used and a warning is printed). REQUIRED in production: use a long random value, e.g.
+#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
+JWT_SECRET=
