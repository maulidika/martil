+// ── real process boot ────────────────────────────────────────────────────────────────────────────────
+function bootChild(file) {
+  const code = `require(${JSON.stringify(DB_MODULE)}).bootDatabase(${JSON.stringify(file)}); console.log('BOOTED');`;
+  const r = spawnSync(process.execPath, ['-e', code], { env: { ...process.env, NODE_NO_WARNINGS: '1' }, encoding: 'utf8' });
+  return { status: r.status, stdout: r.stdout, stderr: r.stderr };
+}
+const lines = (s) => s.split('\n').filter((l) => l.trim() !== '');
+
+test('boot nyata: database dari server lebih baru → exit code 1, SATU baris pendek, tanpa stack trace, tidak lanjut', () => {
+  const file = tmpFile();
+  const d = open(file); d.exec('PRAGMA user_version = 99'); d.close();
+  const r = bootChild(file);
+  assert.equal(r.status, 1);
+  assert.ok(!r.stdout.includes('BOOTED'));
+  const l = lines(r.stderr);
+  assert.equal(l.length, 1, `stderr harus satu baris, dapat:\n${r.stderr}`);
+  assert.match(l[0], /^\[db\] FATAL: database schema version 99 is newer than this server supports \(1\)/);
+  assert.ok(!/\n\s+at /.test(r.stderr) && !/node:internal|SchemaVersionError|\.js:\d+/.test(r.stderr), 'tidak boleh ada stack trace');
+  assert.equal(version(raw(file)), 99, 'database tidak boleh diubah');
+});
+
+test('boot nyata: database valid dengan Room basi → exit code 0, satu log, Room tertutup', () => {
+  const file = tmpFile();
+  const d = open(file); seedRooms(d); d.close();
+  const r = bootChild(file);
+  assert.equal(r.status, 0, r.stderr);
+  assert.ok(r.stdout.includes('BOOTED'));
+  assert.equal(lines(r.stdout).filter((x) => x.includes('DB_STALE_ROOMS_CLOSED')).length, 1);
+  assert.equal(r.stderr, '');
+  const check = raw(file);
+  assert.equal(check.prepare("SELECT COUNT(*) AS n FROM rooms WHERE status IN ('waiting','playing')").get().n, 0);
+});
+
+// ── static guards ────────────────────────────────────────────────────────────────────────────────────
+test('db() tidak pernah memanggil pembersihan (itu hanya untuk startup, bukan inisialisasi lazy)', () => {
