+test('server.js: bootDatabase() dipanggil tepat sekali, setelah dotenv.config() dan sebelum server.listen()', () => {
+  const src = fs.readFileSync(path.join(SRC, 'server.js'), 'utf8');
+  assert.equal((src.match(/bootDatabase\(\);/g) || []).length, 1);
+  const iEnv = src.indexOf('dotenv.config()');
+  const iBoot = src.indexOf('bootDatabase();');
+  const iListen = src.indexOf('server.listen(');
