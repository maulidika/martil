@@ -0,0 +1,386 @@
+'use strict';
+/**
+ * Database schema versioning and startup cleanup, against REAL SQLite (node:sqlite; `:memory:` and temp files).
+ *   npm run test:db      (from the backend folder)
+ *
+ * Covered:
+ *   - a new database ends at user_version = SCHEMA_VERSION with the six tables, their UNIQUE/NOT NULL constraints and defaults
+ *   - an existing database written before versioning (user_version 0, tables + data) is upgraded without losing a row,
+ *     and its schema equals a fresh one
+ *   - opening is idempotent; migrations run in order and only the pending ones run
+ *   - a failing migration is rolled back completely (DDL and user_version) and the error is rethrown
+ *   - a database from a NEWER server is refused (SchemaVersionError) and left untouched
+ *   - closeStaleRooms / bootDatabase: 'waiting' and 'playing' rooms become 'closed'; 'done' and 'closed' rooms and every other
+ *     table/column are untouched (sets.ended_at stays NULL); second run closes nothing; one log line only when something closed
+ *   - real process boot (child process): a newer-version database stops the process with exit code 1 and ONE short line, no stack
+ *   - db() never triggers the cleanup; server.js runs bootDatabase() once, before the server listens
+ *   - the pre-versioning pragmas still apply: WAL on files, foreign_keys ON, data directory created on demand
+ * NOT covered here: a real `npm start` (express/socket.io are not installed in the sandbox) and your own martil.db on Windows
+ * (see the README manual check).
+ */
+process.removeAllListeners('warning'); // node:sqlite prints an ExperimentalWarning on first use; keep test output quiet
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const { DatabaseSync } = require('node:sqlite');
+
+const BACKEND = path.join(__dirname, '..');
+const SRC = path.join(BACKEND, 'src');
+const DB_MODULE = path.join(SRC, 'db/database.js');
+const dbModule = require(DB_MODULE);
+const {
+  openDatabase, bootDatabase, closeStaleRooms, SchemaVersionError, SCHEMA_VERSION,
+} = dbModule;
+
+// The schema exactly as the server created it BEFORE versioning existed (frozen on purpose: proof of upgrade compatibility).
+const LEGACY_SCHEMA = `
+  CREATE TABLE IF NOT EXISTS users (
+    id TEXT PRIMARY KEY,
+    username TEXT UNIQUE NOT NULL,
+    email TEXT,
+    password_hash TEXT NOT NULL,
+    created_at TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+  CREATE TABLE IF NOT EXISTS rooms (
+    id TEXT PRIMARY KEY,
+    code TEXT UNIQUE NOT NULL,
+    host_id TEXT NOT NULL,
+    status TEXT NOT NULL DEFAULT 'waiting',
+    max_games INTEGER NOT NULL DEFAULT 4,
+    created_at TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+  CREATE TABLE IF NOT EXISTS room_players (
+    id TEXT PRIMARY KEY,
+    room_id TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    seat INTEGER NOT NULL,
+    total_score INTEGER NOT NULL DEFAULT 0,
+    UNIQUE(room_id, user_id),
+    UNIQUE(room_id, seat)
+  );
+  CREATE TABLE IF NOT EXISTS sets (
+    id TEXT PRIMARY KEY,
+    room_id TEXT NOT NULL,
+    started_at TEXT NOT NULL DEFAULT (datetime('now')),
+    ended_at TEXT
+  );
+  CREATE TABLE IF NOT EXISTS games (
+    id TEXT PRIMARY KEY,
+    set_id TEXT NOT NULL,
+    game_number INTEGER NOT NULL,
+    winner_id TEXT,
+    win_type TEXT,
+    ended_at TEXT
+  );
+  CREATE TABLE IF NOT EXISTS game_scores (
+    id TEXT PRIMARY KEY,
+    game_id TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    score INTEGER NOT NULL,
+    remaining_cards TEXT,
+    penalty_type TEXT
+  );
+`;
+const TABLES = ['game_scores', 'games', 'room_players', 'rooms', 'sets', 'users'];
+
+// ── helpers ──────────────────────────────────────────────────────────────────────────────────────────
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'martil-db-test-'));
+const handles = [];
+let fileCounter = 0;
+const tmpFile = () => path.join(tmp, `t${fileCounter += 1}.db`);
+const track = (d) => { handles.push(d); return d; };
+const open = (file, migrations) => track(openDatabase(file, migrations));
+const raw = (file) => track(new DatabaseSync(file));
+const version = (d) => d.prepare('PRAGMA user_version').get().user_version;
+const tableNames = (d) => d.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name").all().map((r) => r.name);
+const normSchema = (d) => d.prepare("SELECT name, sql FROM sqlite_master WHERE type='table' ORDER BY name").all()
+  .map((r) => `${r.name}: ${r.sql.replace(/\s+/g, ' ').replace(/IF NOT EXISTS /i, '')}`);
+const snapshot = (d) => Object.fromEntries(TABLES.map((t) => [t, d.prepare(`SELECT * FROM ${t} ORDER BY id`).all().map((r) => ({ ...r }))]));
+// SQLite removes the -wal/-shm files when the LAST connection to a file closes, so leftovers mean a leaked (unclosed) handle.
+const noWalLeft = (file) => !fs.existsSync(`${file}-wal`) && !fs.existsSync(`${file}-shm`);
+const closeAll = () => { for (const d of handles.splice(0)) { try { d.close(); } catch { /* already closed */ } } };
+const throws = (fn) => { try { fn(); } catch (e) { return e; } return null; };
+const captureInfo = (fn) => {
+  const lines = []; const saved = console.info;
+  console.info = (...a) => lines.push(a);
+  try { fn(); } finally { console.info = saved; }
+  return lines;
+};
+
+function seedRooms(d) {
+  d.exec(`
+    INSERT INTO users (id, username, password_hash) VALUES ('u1','andi','x'), ('u2','budi','x');
+    INSERT INTO rooms (id, code, host_id, status, max_games) VALUES
+      ('r-wait','AAAAAA','u1','waiting',3), ('r-play','BBBBBB','u1','playing',4),
+      ('r-done','CCCCCC','u2','done',5),    ('r-closed','DDDDDD','u2','closed',4);
+    INSERT INTO room_players (id, room_id, user_id, seat, total_score) VALUES
+      ('p1','r-play','u1',0,7), ('p2','r-play','u2',1,-7), ('p3','r-done','u1',0,12);
+    INSERT INTO sets (id, room_id, started_at, ended_at) VALUES
+      ('s-play','r-play','2026-01-01 10:00:00', NULL), ('s-done','r-done','2026-01-01 09:00:00','2026-01-01 09:30:00');
+    INSERT INTO games (id, set_id, game_number, winner_id, win_type, ended_at) VALUES
+      ('g1','s-play',1,'u1','normal','2026-01-01 10:05:00'), ('g2','s-done',1,'u2','normal','2026-01-01 09:10:00');
+    INSERT INTO game_scores (id, game_id, user_id, score, remaining_cards, penalty_type) VALUES
+      ('gs1','g1','u1',5,'[]',NULL), ('gs2','g1','u2',-5,'["3S"]','none');
+  `);
+}
+
+const tests = [];
+const test = (name, fn) => tests.push({ name, fn });
+
+// ── new database ─────────────────────────────────────────────────────────────────────────────────────
+test('database baru: user_version = SCHEMA_VERSION (1) dan enam tabel terbentuk', () => {
+  const d = open(':memory:');
+  assert.equal(SCHEMA_VERSION, 1);
+  assert.equal(version(d), SCHEMA_VERSION);
+  assert.deepEqual(tableNames(d), TABLES);
+});
+
+test('database baru: constraint UNIQUE dan NOT NULL berlaku', () => {
+  const d = open(':memory:');
+  d.exec("INSERT INTO users (id, username, password_hash) VALUES ('u1','andi','x')");
+  assert.ok(throws(() => d.exec("INSERT INTO users (id, username, password_hash) VALUES ('u2','andi','y')")), 'username unik');
+  assert.ok(throws(() => d.exec("INSERT INTO users (id, username) VALUES ('u3','citra')")), 'password_hash wajib');
+  d.exec("INSERT INTO rooms (id, code, host_id) VALUES ('r1','ABCDEF','u1')");
+  assert.ok(throws(() => d.exec("INSERT INTO rooms (id, code, host_id) VALUES ('r2','ABCDEF','u1')")), 'kode Room unik');
+  d.exec("INSERT INTO room_players (id, room_id, user_id, seat) VALUES ('p1','r1','u1',0)");
+  assert.ok(throws(() => d.exec("INSERT INTO room_players (id, room_id, user_id, seat) VALUES ('p2','r1','u1',1)")), 'satu akun sekali per Room');
+  assert.ok(throws(() => d.exec("INSERT INTO room_players (id, room_id, user_id, seat) VALUES ('p3','r1','u2',0)")), 'satu kursi sekali per Room');
+});
+
+test('database baru: nilai bawaan kolom (status waiting, max_games 4, ended_at NULL, created_at terisi)', () => {
+  const d = open(':memory:');
+  d.exec("INSERT INTO rooms (id, code, host_id) VALUES ('r1','ABCDEF','u1')");
+  const r = d.prepare("SELECT * FROM rooms WHERE id='r1'").get();
+  assert.equal(r.status, 'waiting');
+  assert.equal(r.max_games, 4);
+  assert.ok(r.created_at);
+  d.exec("INSERT INTO sets (id, room_id) VALUES ('s1','r1')");
+  const s = d.prepare("SELECT * FROM sets WHERE id='s1'").get();
+  assert.equal(s.ended_at, null);
+  assert.ok(s.started_at);
+  d.exec("INSERT INTO room_players (id, room_id, user_id, seat) VALUES ('p1','r1','u1',0)");
+  assert.equal(d.prepare("SELECT total_score FROM room_players WHERE id='p1'").get().total_score, 0);
+});
+
+// ── upgrading an existing (pre-versioning) database ──────────────────────────────────────────────────
+test('database lama (user_version 0, berisi data): naik ke versi 1 tanpa kehilangan satu baris pun', () => {
+  const file = tmpFile();
+  const old = raw(file);
+  old.exec(LEGACY_SCHEMA);
+  seedRooms(old);
+  assert.equal(version(old), 0);
+  const before = snapshot(old);
+  old.close();
+
+  const d = open(file);
+  assert.equal(version(d), SCHEMA_VERSION);
+  assert.deepEqual(snapshot(d), before);
+});
+
+test('skema hasil upgrade database lama identik dengan skema database baru (migrasi v1 = skema lama)', () => {
+  const file = tmpFile();
+  const old = raw(file); old.exec(LEGACY_SCHEMA); old.close();
+  const upgraded = normSchema(open(file));
+  const fresh = normSchema(open(':memory:'));
+  assert.deepEqual(upgraded, fresh);
+  assert.equal(fresh.length, 6);
+});
+
+test('membuka dua kali: idempoten (versi dan data tidak berubah, tidak error)', () => {
+  const file = tmpFile();
+  const a = open(file); seedRooms(a);
+  const snap = snapshot(a); a.close();
+  const b = open(file);
+  assert.equal(version(b), SCHEMA_VERSION);
+  assert.deepEqual(snapshot(b), snap);
+  b.close();
+  const c = open(file);
+  assert.deepEqual(snapshot(c), snap);
+});
+
+// ── migration runner ─────────────────────────────────────────────────────────────────────────────────
+test('migrasi berjalan berurutan; saat dibuka lagi hanya migrasi yang belum dijalankan yang jalan', () => {
+  const calls = [];
+  const m1 = (d) => { calls.push('m1'); d.exec('CREATE TABLE a (id TEXT)'); };
+  const m2 = (d) => { calls.push('m2'); d.exec('CREATE TABLE b (id TEXT)'); };
+  const m3 = (d) => { calls.push('m3'); d.exec('CREATE TABLE c (id TEXT)'); };
+  const file = tmpFile();
+  const d = open(file, [m1, m2]);
+  assert.deepEqual(calls, ['m1', 'm2']);
+  assert.equal(version(d), 2);
+  d.close();
+  const d2 = open(file, [m1, m2, m3]);
+  assert.deepEqual(calls, ['m1', 'm2', 'm3'], 'm1 dan m2 tidak boleh diulang');
+  assert.equal(version(d2), 3);
+  assert.deepEqual(tableNames(d2), ['a', 'b', 'c']);
+});
+
+test('migrasi gagal: DDL dan user_version dibatalkan semua, migrasi sebelumnya tetap, error diteruskan', () => {
+  const m1 = (d) => d.exec('CREATE TABLE a (id TEXT)');
+  const bad = (d) => { d.exec('CREATE TABLE x (id TEXT)'); d.exec('PRAGMA user_version = 99'); throw new Error('boom'); };
+  const file = tmpFile();
+  open(file, [m1]).close();
+  const err = throws(() => openDatabase(file, [m1, bad]));
+  assert.ok(err && err.message === 'boom', 'error asli harus diteruskan');
+  assert.ok(noWalLeft(file), 'koneksi harus ditutup setelah migrasi gagal (tidak boleh bocor)');
+  const d = open(file, [m1]);
+  assert.equal(version(d), 1, 'user_version tidak boleh naik (termasuk PRAGMA di dalam migrasi yang gagal)');
+  assert.deepEqual(tableNames(d), ['a'], 'tabel x harus ikut dibatalkan');
+});
+
+test('migrasi pertama gagal pada database baru: file tetap kosong, versi 0', () => {
+  const file = tmpFile();
+  const err = throws(() => openDatabase(file, [(d) => { d.exec('CREATE TABLE x (id TEXT)'); throw new Error('boom'); }]));
+  assert.ok(err);
+  assert.ok(noWalLeft(file), 'koneksi harus ditutup setelah migrasi gagal (tidak boleh bocor)');
+  const r = raw(file);
+  assert.equal(version(r), 0);
+  assert.deepEqual(tableNames(r), []);
+});
+
+test('database dari server yang LEBIH BARU: ditolak dengan SchemaVersionError dan tidak diubah', () => {
+  const file = tmpFile();
+  const d0 = open(file); seedRooms(d0);
+  d0.exec('PRAGMA user_version = 5');
+  const snap = snapshot(d0); d0.close();
+  let ran = 0;
+  const err = throws(() => openDatabase(file, [(d) => { ran += 1; d.exec(LEGACY_SCHEMA); }]));
+  assert.ok(err instanceof SchemaVersionError);
+  assert.match(err.message, /schema version 5 is newer than this server supports \(1\)/);
+  assert.ok(!err.message.includes('\n') && err.message.length < 200);
+  assert.equal(ran, 0, 'tidak boleh ada migrasi yang dijalankan');
+  assert.ok(noWalLeft(file), 'koneksi harus ditutup setelah penolakan versi (tidak boleh bocor)');
+  const r = raw(file);
+  assert.equal(version(r), 5);
+  assert.deepEqual(snapshot(r), snap);
+});
+
+// ── pragmas and directory (behavior preserved from before versioning) ────────────────────────────────
+test('pragma lama tetap berlaku: WAL pada file, foreign_keys ON, folder data dibuat bila belum ada', () => {
+  const file = path.join(tmp, 'nested', 'deeper', 'martil.db');
+  const d = open(file);
+  assert.ok(fs.existsSync(file));
+  assert.equal(d.prepare('PRAGMA journal_mode').get().journal_mode, 'wal');
+  assert.equal(d.prepare('PRAGMA foreign_keys').get().foreign_keys, 1);
+});
+
+// ── stale room cleanup ───────────────────────────────────────────────────────────────────────────────
+test('closeStaleRooms: waiting dan playing menjadi closed; done dan closed tetap; hanya kolom status yang berubah', () => {
+  const d = open(':memory:'); seedRooms(d);
+  const before = snapshot(d);
+  assert.equal(closeStaleRooms(d), 2);
+  const after = snapshot(d);
+  const status = Object.fromEntries(after.rooms.map((r) => [r.id, r.status]));
+  assert.deepEqual(status, { 'r-wait': 'closed', 'r-play': 'closed', 'r-done': 'done', 'r-closed': 'closed' });
+  const expected = structuredClone(before);
+  for (const r of expected.rooms) if (r.status === 'waiting' || r.status === 'playing') r.status = 'closed';
+  assert.deepEqual(after, expected, 'selain status Room, tidak ada data lain yang boleh berubah');
+});
