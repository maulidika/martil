@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Tests utils/serverErrors.js (REAL file) and checks it against the error codes the REAL backend can send.
+# Needs only Node: no browser, no node_modules.
+#   bash tests/server-errors/run.sh      (from the frontend folder)
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"; SRC="$HERE/../../src"; OUT="$(mktemp -d)"
+cp "$SRC/utils/serverErrors.js" "$OUT/serverErrors.mjs"
+cp "$HERE/run.mjs" "$OUT/run.mjs"
+BACKEND_SRC="$(cd "$HERE/../../../backend/src" && pwd)" node "$OUT/run.mjs"
