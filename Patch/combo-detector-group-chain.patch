   const written = LOW_STRAIGHT_DISPLAY.find(seq => ranks.size === 5 && seq.every(r => ranks.has(r)))
   return written ? written.map(r => cards.find(c => c.rank === r)) : cards
 }
+
+// ── Perbandingan kekuatan (cermin canBeat/compareCombo di backend/src/game/validator.js) ──
+// Dipakai hanya untuk umpan balik instan di UI (tombol PLAY, urutan Combo Detector);
+// server tetap memvalidasi segalanya. Diuji identik dengan server di backend/tests/combo.consistency.js.
+const PAKETAN_TIER = { straight: 1, flush: 2, fullhouse: 3, fourofakind: 4, straightflush: 5, royalflush: 6 }
+const LOW_STRAIGHT_TOP = { '3,4,5,A,2': '5', '3,4,5,6,2': '6' }
+
+// Detail kekuatan sebuah kombinasi hasil detectCombo().
+function strength(combo) {
+  const cards = [...combo.cards].sort(compareCards)
+  const ranks = cards.map(c => c.rank)
+  const counts = ranks.reduce((a, r) => { a[r] = (a[r] || 0) + 1; return a }, {})
+  const rankWith = (n) => Object.keys(counts).find(r => counts[r] === n)
+  const topRank = LOW_STRAIGHT_TOP[ranks.join(',')]
+  const highCard = topRank ? cards.find(c => c.rank === topRank) : cards[4]
+  switch (combo.type) {
+    case 'single': return { cards }
+    case 'pair':   return { rank: cards[0].rank, cards }
+    case 'tris':   return { rank: cards[0].rank, cards }
+    default:
+      return {
+        tier: PAKETAN_TIER[combo.subtype], subtype: combo.subtype, suit: cards[0].suit,
+        highCard, threeRank: rankWith(3), fourRank: rankWith(4), cards,
+      }
+  }
+}
+
+function compareSameSubtype(a, b) {
+  switch (a.subtype) {
+    case 'straight': case 'straightflush': case 'royalflush':
+      return compareCards(a.highCard, b.highCard)
+    case 'flush': {
+      const sv = SV[a.suit] - SV[b.suit]
+      return sv !== 0 ? sv : compareCards(a.highCard, b.highCard)
+    }
+    case 'fullhouse':   return RV[a.threeRank] - RV[b.threeRank]
+    case 'fourofakind': return RV[a.fourRank] - RV[b.fourRank]
+    default: return 0
+  }
+}
+
+// >0 jika a lebih kuat dari b, 0 sama kuat, <0 lebih lemah. Hanya bermakna untuk tipe yang sama.
+export function compareCombos(a, b) {
+  const x = strength(a), y = strength(b)
+  if (a.type === 'single') return compareCards(x.cards[0], y.cards[0])
+  if (a.type === 'pair') {
+    const rv = RV[x.rank] - RV[y.rank]
+    if (rv !== 0) return rv
+    return compareCards(x.cards[1], y.cards[1])   // kartu tertinggi pasangan
+  }
+  if (a.type === 'tris') return RV[x.rank] - RV[y.rank]
+  if (x.tier !== y.tier) return x.tier - y.tier
+  return compareSameSubtype(x, y)
+}
+
+// Apakah `play` boleh dimainkan di atas `table` (meja kosong = selalu boleh).
+export function canBeat(play, table) {
+  if (!play) return false
+  if (!table) return true
+  if (play.type !== table.type) return false
+  if (play.type === 'paketan') {
+    const x = strength(play), y = strength(table)
+    if (x.tier !== y.tier) return x.tier > y.tier
+    return compareSameSubtype(x, y) > 0
+  }
+  return compareCombos(play, table) > 0
+}
diff --git a/frontend/src/utils/comboPicker.js b/frontend/src/utils/comboPicker.js
new file mode 100644
index 0000000..5b0443c
--- /dev/null
+++ b/frontend/src/utils/comboPicker.js
@@ -0,0 +1,74 @@
+// Combo Detector: daftar kombinasi yang bisa dibentuk dari seluruh tangan (dek utama + grup),
+// diurutkan dari terlemah ke terkuat. Memakai detectCombo/compareCombos yang sudah ada.
+import { detectCombo, compareCombos, sortHand } from './comboDetector'
+
+// Urutan tampil jenis kombinasi (dari yang paling lemah).
+export const COMBO_TYPES = [
+  { key: 'single',        label: 'Single' },
+  { key: 'pair',          label: 'Pair' },
+  { key: 'tris',          label: 'Tris' },
+  { key: 'straight',      label: 'Straight' },
+  { key: 'flush',         label: 'Flush' },
+  { key: 'fullhouse',     label: 'Full House' },
+  { key: 'fourofakind',   label: 'Four of a Kind' },
+  { key: 'straightflush', label: 'Straight Flush' },
+  { key: 'royalflush',    label: 'Royal Flush' },
+]
+
+const typeKeyOf = (combo) => combo.subtype || combo.type
+
+// Semua subset ukuran k (indeks naik) dari array.
+function* subsets(arr, k, start = 0, acc = []) {
+  if (acc.length === k) { yield acc.slice(); return }
+  for (let i = start; i <= arr.length - (k - acc.length); i++) {
+    acc.push(arr[i]); yield* subsets(arr, k, i + 1, acc); acc.pop()
+  }
+}
+
+/**
+ * @returns {Record<string, {ids: string[], combo: object}[]>} per jenis, urut terlemah → terkuat.
+ * Kandidat yang sama kuat (mis. Four of a Kind dengan kartu ke-5 berbeda) hanya diwakili satu:
+ * yang tersusun dari kartu terendah, supaya siklus klik tidak berisi pilihan yang setara.
+ */
+export function listAvailableCombos(hand) {
+  const cards = sortHand(hand || [])
+  const byType = {}
+  for (const size of [1, 2, 3, 5]) {
+    if (cards.length < size) continue
+    for (const sub of subsets(cards, size)) {
+      const combo = detectCombo(sub)
+      if (!combo) continue
+      ;(byType[typeKeyOf(combo)] ||= []).push({ ids: sub.map(c => c.id), combo })
+    }
+  }
+  for (const key of Object.keys(byType)) {
+    const sorted = byType[key].map((x, i) => ({ x, i }))
+      .sort((a, b) => compareCombos(a.x.combo, b.x.combo) || a.i - b.i)
+      .map(({ x }) => x)
+    byType[key] = sorted.filter((x, i) => i === 0 || compareCombos(x.combo, sorted[i - 1].combo) !== 0)
+  }
+  return byType
+}
+
+export const sameIds = (a, b) => a.length === b.length && a.every(id => b.includes(id))
+
+/**
+ * Klik pada jenis `type`. Klik berulang pada jenis yang sama (dan seleksi masih persis kandidat
+ * terakhir) maju ke kandidat berikutnya, lalu kembali ke yang pertama. Selain itu mulai dari yang terlemah.
+ * @returns {{ids: string[], index: number, count: number} | null}
+ */
+export function pickNext(available, type, last, selectedIds) {
+  const list = available?.[type]
+  if (!list?.length) return null
+  let index = 0
+  if (last && last.type === type && list[last.index] && sameIds(list[last.index].ids, selectedIds)) {
+    index = (last.index + 1) % list.length
+  }
+  return { ids: list[index].ids, index, count: list.length }
+}
+
+/** Pilihan Combo Detector yang masih berlaku (seleksi saat ini persis kandidat terakhir), atau null. */
+export function activePickOf(lastPick, available, selectedIds) {
+  const cand = lastPick && available?.[lastPick.type]?.[lastPick.index]
+  return cand && sameIds(cand.ids, selectedIds) ? lastPick : null
+}
diff --git a/frontend/src/utils/groupChain.js b/frontend/src/utils/groupChain.js
new file mode 100644
index 0000000..29ed49d
--- /dev/null
+++ b/frontend/src/utils/groupChain.js
@@ -0,0 +1,61 @@
+// Group Chain: pengelompokan kartu di tangan (state murni; UI ada di GamePage.jsx).
+// groups = array grup, tiap grup array id kartu (urutan tampil = urutan tangan).
+
+// Buang grup yang menyentuh kartu yang sudah tidak ada di tangan (mis. sudah dimainkan):
+// grup itu dibubarkan seluruhnya sehingga sisa kartunya kembali ke dek utama.
+// Mengembalikan array yang SAMA bila tidak ada perubahan.
+export function pruneGroups(groups, handIds) {
+  const have = new Set(handIds)
+  const kept = groups.filter(g => g.length >= 2 && g.every(id => have.has(id)))
+  return kept.length === groups.length ? groups : kept
+}
+
+// Buat grup baru dari kartu terpilih (minimal 2). Grup lama yang kartunya ikut terpilih
+// dibubarkan; sisa kartunya kembali ke dek utama.
+export function groupSelected(groups, selectedIds, handOrderIds) {
+  const sel = new Set(selectedIds)
+  if (sel.size < 2) return groups
+  const rest = groups.filter(g => !g.some(id => sel.has(id)))
+  const ordered = handOrderIds.filter(id => sel.has(id))
+  return [...rest, ordered]
+}
+
+export function ungroupAt(groups, index) {
+  return groups.filter((_, i) => i !== index)
+}
+
+// Kartu dek utama = tangan tanpa kartu yang ada di grup.
+export function mainDeckIds(handOrderIds, groups) {
+  const grouped = new Set(groups.flat())
+  return handOrderIds.filter(id => !grouped.has(id))
+}
+
+export const isGroupSelected = (group, selectedIds) => group.every(id => selectedIds.includes(id))
+
+// ── Prioritas seleksi: aksi seleksi terbaru menggantikan seleksi dari Combo Detector ──
+// sel = { ids: string[], source: 'manual' | 'detector' | null }
+export const EMPTY_SELECTION = { ids: [], source: null }
+
+export function selectByDetector(ids) { return { ids: [...ids], source: 'detector' } }
+
+export function tapCard(sel, id) {
+  if (sel.source === 'detector') return { ids: [id], source: 'manual' }
+  return { ids: sel.ids.includes(id) ? sel.ids.filter(x => x !== id) : [...sel.ids, id], source: 'manual' }
+}
+
+export function tapGroup(sel, groupIds) {
+  if (sel.source === 'detector') return { ids: [...groupIds], source: 'manual' }
+  if (groupIds.every(id => sel.ids.includes(id))) {
+    return { ids: sel.ids.filter(id => !groupIds.includes(id)), source: 'manual' }
+  }
+  return { ids: [...new Set([...sel.ids, ...groupIds])], source: 'manual' }
+}
+
+// Posisi tombol di atas sekumpulan kartu: tengah-tengah rentang horizontal, di atas kartu tertinggi.
+// rects: [{ left, top, width }] relatif terhadap wadah.
+export function anchorAbove(rects) {
+  if (!rects.length) return null
+  const left = Math.min(...rects.map(r => r.left))
+  const right = Math.max(...rects.map(r => r.left + r.width))
+  return { x: (left + right) / 2, y: Math.min(...rects.map(r => r.top)) }
+}
diff --git a/frontend/src/utils/handUi.js b/frontend/src/utils/handUi.js
new file mode 100644
index 0000000..245e046
--- /dev/null
+++ b/frontend/src/utils/handUi.js
@@ -0,0 +1,52 @@
+// Logika interaksi tangan di GamePage (seleksi, Combo Detector, Group Chain) sebagai fungsi murni
+// supaya bisa diuji tanpa browser. GamePage hanya menyambungkannya ke state React dan gameStore.
+//
+// ui     = { key, groups, source, lastPick }   (state lokal UI; direset per room+game karena id kartu dipakai ulang)
+// selIds = id kartu terpilih (disimpan di gameStore.selectedIds)
+import { pickNext, activePickOf } from './comboPicker'
+import {
+  pruneGroups, groupSelected, ungroupAt, selectByDetector, tapCard, tapGroup,
+} from './groupChain'
+
+export const INITIAL_UI = { key: null, groups: [], source: null, lastPick: null }
+
+/** Samakan ui dengan tangan saat ini: game/room baru → reset; kartu keluar dari tangan → grup terkait bubar. */
+export function syncUi(ui, key, handIds) {
+  if (ui.key !== key) return { ...INITIAL_UI, key }
+  const groups = pruneGroups(ui.groups, handIds)
+  return groups === ui.groups ? ui : { ...ui, groups }
+}
+
+/**
+ * @param action  {type:'detector', available, kind} | {type:'tapCard', id} | {type:'tapGroup', index}
+ *                | {type:'group'} | {type:'ungroup', index} | {type:'clear'}
+ * @returns {{ui, selIds}}
+ */
+export function reduceHandUi(ui, selIds, handIds, action) {
+  const sel = { ids: selIds, source: ui.source }
+  switch (action.type) {
+    case 'detector': {
+      const r = pickNext(action.available, action.kind, activePickOf(ui.lastPick, action.available, selIds), selIds)
+      if (!r) return { ui, selIds }
+      return { ui: { ...ui, source: 'detector', lastPick: { type: action.kind, index: r.index } }, selIds: selectByDetector(r.ids).ids }
+    }
+    case 'tapCard': {
+      const n = tapCard(sel, action.id)
+      return { ui: { ...ui, source: n.source }, selIds: n.ids }
+    }
+    case 'tapGroup': {
+      const n = tapGroup(sel, ui.groups[action.index])
+      return { ui: { ...ui, source: n.source }, selIds: n.ids }
+    }
+    case 'group': {
+      if (selIds.length < 2) return { ui, selIds }
+      return { ui: { ...ui, groups: groupSelected(ui.groups, selIds, handIds), source: null, lastPick: null }, selIds: [] }
+    }
+    case 'ungroup':
+      return { ui: { ...ui, groups: ungroupAt(ui.groups, action.index), source: null, lastPick: null }, selIds: [] }
+    case 'clear':   // CLEAR / setelah PLAY / SKIP: hanya seleksi yang dibersihkan, Group Chain tetap
+      return { ui: { ...ui, source: null, lastPick: null }, selIds: [] }
+    default:
+      return { ui, selIds }
+  }
+}
diff --git a/frontend/tests/combo-ui/render.mjs b/frontend/tests/combo-ui/render.mjs
